int pins[]={2,3,4,5};
int count=0;
void setup() {
  // put your setup code here, to run once:
for(int i=0;i<4;i++){
  pinMode(pins[i],OUTPUT);
}
}

void loop() {
  // put your main code here, to run repeatedly:
for(int i=0;i<4;i++){
  digitalWrite(pins[i],(count>>i)&1);
}
delay(1000);
count++;
if(count>9){
  count=0;
}
}
